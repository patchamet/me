---
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal portfolio and CV" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {/* Set theme attribute before paint to avoid FOUC */}
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch (_) {}
        const t =
          saved === 'dark' || saved === 'light'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    {/* Ambient PCB background — faint circuit traces with a slow current
        pulse, behind all content (z-index -1). The pulse is kept fainter in
        light mode; it freezes automatically under prefers-reduced-motion. */}
    <div class="site-bg" aria-hidden="true">
      <svg
        class="pcb"
        viewBox="0 0 1200 800"
        preserveAspectRatio="xMidYMid slice"
        xmlns="http://www.w3.org/2000/svg"
      >
        <polyline class="pcb-trace" points="0,120 240,120 280,160 520,160 560,120 900,120 940,160 1200,160" />
        <polyline class="pcb-trace" points="0,300 180,300 220,260 460,260 500,300 760,300 800,340 1200,340" />
        <polyline class="pcb-trace" points="0,500 300,500 340,540 620,540 660,500 1000,500 1040,540 1200,540" />
        <polyline class="pcb-trace" points="0,680 220,680 260,640 540,640 580,680 880,680 920,640 1200,640" />
        <polyline class="pcb-trace" points="160,0 160,120 200,160 200,400 240,440 240,800" />
        <polyline class="pcb-trace" points="600,0 600,160 560,200 560,500 600,540 600,800" />
        <polyline class="pcb-trace" points="980,0 980,160 1020,200 1020,440 980,480 980,800" />
        <circle class="pcb-node" cx="240" cy="120" r="4" />
        <circle class="pcb-node" cx="560" cy="120" r="4" />
        <circle class="pcb-node" cx="500" cy="300" r="4" />
        <circle class="pcb-node" cx="660" cy="500" r="4" />
        <circle class="pcb-node" cx="580" cy="680" r="4" />
        <circle class="pcb-node" cx="200" cy="160" r="4" />
        <circle class="pcb-node" cx="980" cy="160" r="4" />
        <circle class="pcb-node" cx="600" cy="540" r="4" />
        {/* Current pulses — each is a comet: a bright head + three fainter,
            thinner trailing copies that lag a few px behind (animation-delay)
            so the tail fades out instead of reading as a solid bar. Paths are
            declared once in <defs> and reused. */}
        <defs>
          <polyline id="pcb-path-1" points="0,120 240,120 280,160 520,160 560,120 900,120 940,160 1200,160" />
          <polyline id="pcb-path-2" points="0,500 300,500 340,540 620,540 660,500 1000,500 1040,540 1200,540" />
          <polyline id="pcb-path-3" points="600,0 600,160 560,200 560,500 600,540 600,800" />
        </defs>
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-head" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t1" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t2" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t3" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t4" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t5" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t6" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t7" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t8" />
        <use href="#pcb-path-1" class="pcb-pulse pcb-p1 pcb-t9" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-head" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t1" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t2" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t3" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t4" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t5" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t6" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t7" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t8" />
        <use href="#pcb-path-2" class="pcb-pulse pcb-p2 pcb-t9" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-head" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t1" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t2" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t3" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t4" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t5" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t6" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t7" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t8" />
        <use href="#pcb-path-3" class="pcb-pulse pcb-p3 pcb-t9" />
      </svg>
    </div>

    <slot />

    {/* Scroll reveal — adds .in to .reveal / .mask-line / .marker on enter */}
    <script>
      const reveals = document.querySelectorAll<HTMLElement>(
        ".reveal, .mask-line, .marker"
      );
      if (reveals.length && "IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                obs.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        for (const el of reveals) obs.observe(el);
      } else {
        for (const el of reveals) el.classList.add("in");
      }
    </script>

    {/* Lightning bolts — each strike is a NEW random bolt shape, fired
        at a random interval (0.5-3.5s between strikes). The Ω strike
        glow is fired in lockstep. Skipped under prefers-reduced-motion. */}
    <script>
      const reducedMotionZap = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reducedMotionZap) {
        // Midpoint-displacement bolt in the 10x30 viewBox space — the same
        // thin, finely-jagged, forked style as the cursor lightning.
        const mid = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          disp: number,
          out: number[][],
        ) => {
          if (disp < 0.4) {
            out.push([x2, y2]);
            return;
          }
          const mx = (x1 + x2) / 2 + (Math.random() - 0.5) * disp;
          const my = (y1 + y2) / 2 + (Math.random() - 0.5) * disp;
          mid(x1, y1, mx, my, disp * 0.55, out);
          mid(mx, my, x2, y2, disp * 0.55, out);
        };
        const boltPts = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          disp: number,
        ): number[][] => {
          const out: number[][] = [[x1, y1]];
          mid(x1, y1, x2, y2, disp, out);
          return out;
        };
        const ptsToStr = (pts: number[][]) =>
          pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
        // A short fork splitting off an interior vertex of the main bolt.
        const forkPts = (main: number[][]): number[][] => {
          const i = 2 + Math.floor(Math.random() * Math.max(1, main.length - 4));
          const [bx, by] = main[i];
          const len = 2.5 + Math.random() * 4;
          const ang = Math.random() * Math.PI * 2;
          return boltPts(
            bx,
            by,
            bx + Math.cos(ang) * len,
            by + Math.sin(ang) * len,
            Math.min(len * 0.6, 2.2),
          );
        };
        const randomize = (zap: Element) => {
          // Generate one shape (main bolt + forks) and apply the identical
          // points to BOTH the blue body group and the white core group, so
          // they stay perfectly in register — the same dual-pass look as the
          // cursor trail.
          const main = boltPts(5, 0, 4, 30, 5.5);
          const mainStr = ptsToStr(main);
          const n = 1 + Math.floor(Math.random() * 3);
          const forkStrs: string[] = [];
          for (let k = 0; k < n; k++) forkStrs.push(ptsToStr(forkPts(main)));

          for (const sel of [".zap-body", ".zap-core"]) {
            const g = zap.querySelector(sel)!;
            const first = g.querySelector("polyline")!;
            first.setAttribute("points", mainStr);
            // drop the previous forks, keep the main (first) polyline
            const polys = g.querySelectorAll("polyline");
            for (let i = 1; i < polys.length; i++) polys[i].remove();
            // Fresh forks by cloning the main polyline rather than
            // createElementNS: a hand-built element misses Astro's scoped
            // style hash, so it would fall back to SVG defaults (fill: black)
            // and render as a solid black blob. Cloning carries the hash over.
            for (const f of forkStrs) {
              const pl = first.cloneNode(false) as Element;
              pl.setAttribute("points", f);
              g.appendChild(pl);
            }
          }
        };

        const zap = document.querySelector<SVGElement>(".zap");
        const strikeWrap = document.querySelector<HTMLElement>(".strike-wrap");

        if (zap && strikeWrap) {
          const strike = () => {
            // Re-randomize the bolt shape for this strike
            randomize(zap);

            // Restart the one-shot CSS animations by toggling the class.
            // Force reflow between remove and add so the keyframe replays.
            zap.classList.remove("striking");
            strikeWrap.classList.remove("striking");
            void zap.getBoundingClientRect();
            void strikeWrap.getBoundingClientRect();
            zap.classList.add("striking");
            strikeWrap.classList.add("striking");

            // Schedule the next strike at a random interval 0.3-4s
            const nextDelay = 300 + Math.random() * 3700;
            window.setTimeout(strike, nextDelay);
          };

          // First strike fires once the entire hero entrance is done —
          // wait for the callme line to finish typing, then a brief
          // breath, then start the lightning loop. Falls back to a
          // fixed delay if callme is missing for any reason.
          const callme = document.getElementById("hero-callme");
          if (callme) {
            callme.addEventListener(
              "typewrite-done",
              () => window.setTimeout(strike, 500),
              { once: true },
            );
          } else {
            window.setTimeout(strike, 3200);
          }
        }
      }
    </script>

    {/* Cursor lightning — a short, jagged bolt crackles between the last
        and current pointer position, trailing the mouse. Uses the same
        plasma palette as the hero bolt, theme-aware. Desktop (fine
        pointer) only; skipped under prefers-reduced-motion. */}
    <script>
      const rmCursor = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const finePointer = window.matchMedia("(pointer: fine)").matches;
      if (!rmCursor && finePointer) {
        const canvas = document.createElement("canvas");
        canvas.setAttribute("aria-hidden", "true");
        Object.assign(canvas.style, {
          position: "fixed",
          inset: "0",
          width: "100%",
          height: "100%",
          pointerEvents: "none",
          zIndex: "9", // below the sticky header (z-index 10), above content
        });
        document.body.appendChild(canvas);
        const ctx = canvas.getContext("2d")!;

        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        const resize = () => {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(window.innerWidth * dpr);
          canvas.height = Math.floor(window.innerHeight * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener("resize", resize);

        // Palette mirrors the hero bolt's .zap-host vars, per theme.
        const palette = () =>
          document.documentElement.getAttribute("data-theme") === "light"
            ? { core: "#0284c7", glow: "#7dd3fc", glow2: "#38bdf8" }
            : { core: "#ffffff", glow: "#00d4ff", glow2: "#0051ff" };

        // Recursive midpoint displacement → a jagged bolt between 2 points.
        // Low threshold + slow decay = many fine zigzags (a thin, crackly line).
        const makeBolt = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          displace: number,
        ): number[][] => {
          if (displace < 2) return [[x1, y1], [x2, y2]];
          const mx = (x1 + x2) / 2 + (Math.random() - 0.5) * displace;
          const my = (y1 + y2) / 2 + (Math.random() - 0.5) * displace;
          return makeBolt(x1, y1, mx, my, displace * 0.55)
            .slice(0, -1)
            .concat(makeBolt(mx, my, x2, y2, displace * 0.55));
        };

        // A few short forks off interior vertices → the "cracked" branch look.
        const makeBranches = (pts: number[][]): number[][][] => {
          const out: number[][][] = [];
          const n = 1 + Math.floor(Math.random() * 2); // 1-2 forks
          for (let k = 0; k < n; k++) {
            const idx = 1 + Math.floor(Math.random() * (pts.length - 2));
            const [bx, by] = pts[idx];
            const len = 7 + Math.random() * 15;
            const ang = Math.random() * Math.PI * 2;
            const ex = bx + Math.cos(ang) * len;
            const ey = by + Math.sin(ang) * len;
            out.push(makeBolt(bx, by, ex, ey, Math.min(len * 0.5, 9)));
          }
          return out;
        };

        type Bolt = { main: number[][]; branches: number[][][]; life: number };
        const bolts: Bolt[] = [];
        let prevX = 0,
          prevY = 0,
          hasPrev = false,
          lastSpawn = 0,
          raf = 0;

        type Palette = { core: string; glow: string; glow2: string };
        const strokePath = (
          pts: number[][],
          wGlow: number,
          wCore: number,
          alpha: number,
          c: Palette,
        ) => {
          ctx.beginPath();
          ctx.moveTo(pts[0][0], pts[0][1]);
          for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j][0], pts[j][1]);
          // soft glow pass
          ctx.globalAlpha = alpha * 0.5;
          ctx.lineWidth = wGlow;
          ctx.strokeStyle = c.glow2;
          ctx.shadowBlur = 9;
          ctx.shadowColor = c.glow;
          ctx.stroke();
          // thin crisp core pass
          ctx.globalAlpha = alpha;
          ctx.lineWidth = wCore;
          ctx.strokeStyle = c.core;
          ctx.shadowBlur = 4;
          ctx.shadowColor = c.glow;
          ctx.stroke();
        };

        const draw = () => {
          ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          const c = palette();
          ctx.lineJoin = "round";
          ctx.lineCap = "round";
          for (let i = bolts.length - 1; i >= 0; i--) {
            const b = bolts[i];
            b.life -= 0.07;
            if (b.life <= 0) {
              bolts.splice(i, 1);
              continue;
            }
            strokePath(b.main, 2.2, 0.7, b.life, c);
            for (const br of b.branches) strokePath(br, 1.3, 0.45, b.life * 0.8, c);
          }
          ctx.globalAlpha = 1;
          ctx.shadowBlur = 0;
          raf = bolts.length ? requestAnimationFrame(draw) : 0;
        };

        window.addEventListener(
          "pointermove",
          (e) => {
            const x = e.clientX,
              y = e.clientY;
            if (!hasPrev) {
              prevX = x;
              prevY = y;
              hasPrev = true;
              return;
            }
            const dist = Math.hypot(x - prevX, y - prevY);
            // Treat a big jump (re-entry / teleport) as a fresh start, no bolt.
            if (dist > 300) {
              prevX = x;
              prevY = y;
              lastSpawn = e.timeStamp;
              return;
            }
            if (e.timeStamp - lastSpawn > 45 && dist > 8) {
              const displace = Math.min(dist * 0.45, 30);
              const main = makeBolt(prevX, prevY, x, y, displace);
              bolts.push({ main, branches: makeBranches(main), life: 1 });
              if (bolts.length > 12) bolts.shift();
              lastSpawn = e.timeStamp;
              prevX = x;
              prevY = y;
              if (!raf) raf = requestAnimationFrame(draw);
            }
          },
          { passive: true },
        );
      }
    </script>

    {/* Custom cursor — a small plasma dot replaces the native arrow, wrapped
        in a soft spark glow. The cursor only "charges" while the pointer is
        moving: dot + glow light up on motion and fade back to a faint point
        once it stops, mirroring the lightning trail that streams behind it.
        The glow stays hidden over interactive elements so it never obscures a
        button's label. Desktop (fine pointer) only; under
        prefers-reduced-motion the native cursor is kept. */}
    <script>
      const rmDot = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const fineDot = window.matchMedia("(pointer: fine)").matches;
      if (!rmDot && fineDot) {
        const dotPalette = () =>
          document.documentElement.getAttribute("data-theme") === "light"
            ? { core: "#0284c7", soft: "#7dd3fc" }
            : { core: "#ffffff", soft: "#00d4ff" };

        const dot = document.createElement("div");
        const glow = document.createElement("div");
        dot.setAttribute("aria-hidden", "true");
        glow.setAttribute("aria-hidden", "true");
        Object.assign(dot.style, {
          position: "fixed",
          left: "0",
          top: "0",
          width: "6px",
          height: "6px",
          borderRadius: "50%",
          pointerEvents: "none",
          zIndex: "60",
          opacity: "0",
          transition: "opacity 0.2s, box-shadow 0.25s",
        });
        Object.assign(glow.style, {
          position: "fixed",
          left: "0",
          top: "0",
          width: "32px",
          height: "32px",
          borderRadius: "50%",
          pointerEvents: "none",
          zIndex: "58",
          opacity: "0",
          transition: "opacity 0.3s ease-out",
        });
        document.body.append(glow, dot);

        const interactiveSel =
          "a, button, [role=button], summary, label, [data-magnet]";
        let dotShown = false;
        let overInteractive = false;
        let moving = false;
        let idleTimer = 0;

        // The cursor only lights up while the pointer is actually moving.
        //   moving  → bright plasma dot + soft spark glow (glow stays hidden
        //             over buttons so it never masks a label).
        //   at rest → glow dims to a faint residual and the dot calms to a
        //             faint point, so the cursor stays visible but no longer
        //             "charged". The glow only fully hides over buttons.
        const applyState = () => {
          if (!dotShown) return;
          const p = dotPalette();
          dot.style.opacity = "1";
          dot.style.boxShadow = moving
            ? `0 0 6px ${p.soft}, 0 0 12px ${p.soft}`
            : `0 0 3px ${p.soft}`;
          glow.style.opacity = overInteractive ? "0" : moving ? "1" : "0.18";
        };

        const paintDot = () => {
          const p = dotPalette();
          dot.style.background = p.core;
          glow.style.background = `radial-gradient(circle, ${p.soft} 0%, transparent 70%)`;
          applyState();
        };
        paintDot();
        // keep the dot/glow colour in sync with the theme toggle
        new MutationObserver(paintDot).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });

        window.addEventListener(
          "pointermove",
          (e) => {
            dot.style.transform = `translate(${e.clientX - 3}px, ${e.clientY - 3}px)`;
            glow.style.transform = `translate(${e.clientX - 16}px, ${e.clientY - 16}px)`;
            if (!dotShown) {
              // reveal + hide the native cursor only once JS is confirmed live
              dotShown = true;
              document.documentElement.classList.add("cursor-ready");
            }
            moving = true;
            applyState();
            // let the charge fade back out shortly after motion stops
            clearTimeout(idleTimer);
            idleTimer = window.setTimeout(() => {
              moving = false;
              applyState();
            }, 240);
          },
          { passive: true },
        );
        // hide the glow over interactive elements, restore it elsewhere
        document.addEventListener("pointerover", (e) => {
          const t = e.target as Element;
          overInteractive = !!t.closest?.(interactiveSel);
          applyState();
        });
        // hide when the pointer leaves the window, calm on return
        document.addEventListener("mouseleave", () => {
          clearTimeout(idleTimer);
          moving = false;
          dot.style.opacity = "0";
          glow.style.opacity = "0";
        });
        document.addEventListener("mouseenter", applyState);
      }
    </script>

    {/* Time-delayed entrance — adds .in to elements after data-show-delay ms */}
    <script>
      for (const el of document.querySelectorAll<HTMLElement>("[data-show-delay]")) {
        const delay = +(el.getAttribute("data-show-delay") ?? "0");
        setTimeout(() => el.classList.add("in"), delay);
      }
    </script>

    {/* Magnetic buttons — translate toward cursor on hover.
        Skipped when the user prefers reduced motion. */}
    <script>
      const reducedMotionMagnet = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reducedMotionMagnet) {
        const STRENGTH = 0.35;
        for (const el of document.querySelectorAll<HTMLElement>(
          "[data-magnet]",
        )) {
          el.addEventListener("mousemove", (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * STRENGTH;
            const y = (e.clientY - r.top - r.height / 2) * STRENGTH;
            el.style.transform = `translate(${x}px, ${y}px)`;
          });
          el.addEventListener("mouseleave", () => {
            el.style.transform = "";
          });
        }
      }
    </script>

    {/* Typewriter — types text with a blinking caret. Supports:
        data-typewrite (text), data-delay (ms before start),
        data-speed (ms/char, default 22), data-on-view (start when scrolled
        in), data-after (id of another typewriter element to chain after),
        data-tail (HTML appended after typing completes). */}
    <script>
      const reducedMotionTw = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      function typewrite(
        el: HTMLElement,
        text: string,
        speed: number,
        onDone?: () => void,
      ) {
        // Respect prefers-reduced-motion: render the full text instantly,
        // skip the caret + per-char animation entirely.
        if (reducedMotionTw) {
          el.textContent = text;
          onDone?.();
          return;
        }
        el.innerHTML =
          '<span class="tw-text"></span><span class="tw-caret">▍</span>';
        const textSpan = el.querySelector<HTMLSpanElement>(".tw-text")!;
        const caret = el.querySelector<HTMLSpanElement>(".tw-caret")!;
        let i = 0;
        const tick = () => {
          i++;
          textSpan.textContent = text.slice(0, i);
          if (i < text.length) setTimeout(tick, speed);
          else {
            caret.remove();
            onDone?.();
          }
        };
        tick();
      }

      for (const el of document.querySelectorAll<HTMLElement>(
        "[data-typewrite]",
      )) {
        const text = el.getAttribute("data-typewrite") ?? "";
        const delay = +(el.getAttribute("data-delay") ?? "0");
        const speed = +(el.getAttribute("data-speed") ?? "22");
        const onView = el.hasAttribute("data-on-view");
        const tail = el.getAttribute("data-tail");
        const afterId = el.getAttribute("data-after");

        const start = () =>
          setTimeout(() => {
            typewrite(el, text, speed, () => {
              if (tail) el.insertAdjacentHTML("beforeend", tail);
              el.dispatchEvent(new CustomEvent("typewrite-done"));
            });
          }, delay);

        if (afterId) {
          const after = document.getElementById(afterId);
          if (after) {
            after.addEventListener("typewrite-done", start, { once: true });
          } else {
            start();
          }
        } else if (onView) {
          if ("IntersectionObserver" in window) {
            const obs = new IntersectionObserver(
              (entries) => {
                for (const e of entries) {
                  if (e.isIntersecting) {
                    start();
                    obs.disconnect();
                    return;
                  }
                }
              },
              { threshold: 0.1 },
            );
            obs.observe(el);
          } else {
            start();
          }
        } else {
          start();
        }
      }
    </script>
  </body>
</html>
