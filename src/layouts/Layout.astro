---
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal portfolio and CV" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {/* Set theme attribute before paint to avoid FOUC */}
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch (_) {}
        const t =
          saved === 'dark' || saved === 'light'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <slot />

    {/* Scroll reveal — adds .in to .reveal / .mask-line / .marker on enter */}
    <script>
      const reveals = document.querySelectorAll<HTMLElement>(
        ".reveal, .mask-line, .marker"
      );
      if (reveals.length && "IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                obs.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        for (const el of reveals) obs.observe(el);
      } else {
        for (const el of reveals) el.classList.add("in");
      }
    </script>

    {/* Lightning bolts — each strike is a NEW random bolt shape, fired
        at a random interval (0.5-3.5s between strikes). The Ω strike
        glow is fired in lockstep. Skipped under prefers-reduced-motion. */}
    <script>
      const reducedMotionZap = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reducedMotionZap) {
        // Midpoint-displacement bolt in the 10x30 viewBox space — the same
        // thin, finely-jagged, forked style as the cursor lightning.
        const mid = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          disp: number,
          out: number[][],
        ) => {
          if (disp < 0.6) {
            out.push([x2, y2]);
            return;
          }
          const mx = (x1 + x2) / 2 + (Math.random() - 0.5) * disp;
          const my = (y1 + y2) / 2 + (Math.random() - 0.5) * disp;
          mid(x1, y1, mx, my, disp * 0.55, out);
          mid(mx, my, x2, y2, disp * 0.55, out);
        };
        const boltPts = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          disp: number,
        ): number[][] => {
          const out: number[][] = [[x1, y1]];
          mid(x1, y1, x2, y2, disp, out);
          return out;
        };
        const ptsToStr = (pts: number[][]) =>
          pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
        // A short fork splitting off an interior vertex of the main bolt.
        const forkPts = (main: number[][]): number[][] => {
          const i = 2 + Math.floor(Math.random() * Math.max(1, main.length - 4));
          const [bx, by] = main[i];
          const len = 2.5 + Math.random() * 4;
          const ang = Math.random() * Math.PI * 2;
          return boltPts(
            bx,
            by,
            bx + Math.cos(ang) * len,
            by + Math.sin(ang) * len,
            Math.min(len * 0.6, 2.2),
          );
        };
        const SVGNS = "http://www.w3.org/2000/svg";
        const randomize = (zap: Element) => {
          const g = zap.querySelector("g")!;
          const main = boltPts(5, 0, 4, 30, 5.5);
          const first = zap.querySelector("polyline")!;
          first.setAttribute("points", ptsToStr(main));
          // drop the previous forks, keep the main (first) polyline
          const polys = zap.querySelectorAll("polyline");
          for (let i = 1; i < polys.length; i++) polys[i].remove();
          // 1-3 fresh forks off the main bolt
          const n = 1 + Math.floor(Math.random() * 3);
          for (let k = 0; k < n; k++) {
            const pl = document.createElementNS(SVGNS, "polyline");
            pl.setAttribute("points", ptsToStr(forkPts(main)));
            g.appendChild(pl);
          }
        };

        const zap = document.querySelector<SVGElement>(".zap");
        const strikeWrap = document.querySelector<HTMLElement>(".strike-wrap");

        if (zap && strikeWrap) {
          const strike = () => {
            // Re-randomize the bolt shape for this strike
            randomize(zap);

            // Restart the one-shot CSS animations by toggling the class.
            // Force reflow between remove and add so the keyframe replays.
            zap.classList.remove("striking");
            strikeWrap.classList.remove("striking");
            void zap.getBoundingClientRect();
            void strikeWrap.getBoundingClientRect();
            zap.classList.add("striking");
            strikeWrap.classList.add("striking");

            // Schedule the next strike at a random interval 0.3-4s
            const nextDelay = 300 + Math.random() * 3700;
            window.setTimeout(strike, nextDelay);
          };

          // First strike fires once the entire hero entrance is done —
          // wait for the callme line to finish typing, then a brief
          // breath, then start the lightning loop. Falls back to a
          // fixed delay if callme is missing for any reason.
          const callme = document.getElementById("hero-callme");
          if (callme) {
            callme.addEventListener(
              "typewrite-done",
              () => window.setTimeout(strike, 500),
              { once: true },
            );
          } else {
            window.setTimeout(strike, 3200);
          }
        }
      }
    </script>

    {/* Cursor lightning — a short, jagged bolt crackles between the last
        and current pointer position, trailing the mouse. Uses the same
        plasma palette as the hero bolt, theme-aware. Desktop (fine
        pointer) only; skipped under prefers-reduced-motion. */}
    <script>
      const rmCursor = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const finePointer = window.matchMedia("(pointer: fine)").matches;
      if (!rmCursor && finePointer) {
        const canvas = document.createElement("canvas");
        canvas.setAttribute("aria-hidden", "true");
        Object.assign(canvas.style, {
          position: "fixed",
          inset: "0",
          width: "100%",
          height: "100%",
          pointerEvents: "none",
          zIndex: "9", // below the sticky header (z-index 10), above content
        });
        document.body.appendChild(canvas);
        const ctx = canvas.getContext("2d")!;

        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        const resize = () => {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(window.innerWidth * dpr);
          canvas.height = Math.floor(window.innerHeight * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener("resize", resize);

        // Palette mirrors the hero bolt's .zap-host vars, per theme.
        const palette = () =>
          document.documentElement.getAttribute("data-theme") === "light"
            ? { core: "#0284c7", glow: "#7dd3fc", glow2: "#38bdf8" }
            : { core: "#ffffff", glow: "#00d4ff", glow2: "#0051ff" };

        // Recursive midpoint displacement → a jagged bolt between 2 points.
        // Low threshold + slow decay = many fine zigzags (a thin, crackly line).
        const makeBolt = (
          x1: number,
          y1: number,
          x2: number,
          y2: number,
          displace: number,
        ): number[][] => {
          if (displace < 2) return [[x1, y1], [x2, y2]];
          const mx = (x1 + x2) / 2 + (Math.random() - 0.5) * displace;
          const my = (y1 + y2) / 2 + (Math.random() - 0.5) * displace;
          return makeBolt(x1, y1, mx, my, displace * 0.55)
            .slice(0, -1)
            .concat(makeBolt(mx, my, x2, y2, displace * 0.55));
        };

        // A few short forks off interior vertices → the "cracked" branch look.
        const makeBranches = (pts: number[][]): number[][][] => {
          const out: number[][][] = [];
          const n = 1 + Math.floor(Math.random() * 2); // 1-2 forks
          for (let k = 0; k < n; k++) {
            const idx = 1 + Math.floor(Math.random() * (pts.length - 2));
            const [bx, by] = pts[idx];
            const len = 7 + Math.random() * 15;
            const ang = Math.random() * Math.PI * 2;
            const ex = bx + Math.cos(ang) * len;
            const ey = by + Math.sin(ang) * len;
            out.push(makeBolt(bx, by, ex, ey, Math.min(len * 0.5, 9)));
          }
          return out;
        };

        type Bolt = { main: number[][]; branches: number[][][]; life: number };
        const bolts: Bolt[] = [];
        let prevX = 0,
          prevY = 0,
          hasPrev = false,
          lastSpawn = 0,
          raf = 0;

        type Palette = { core: string; glow: string; glow2: string };
        const strokePath = (
          pts: number[][],
          wGlow: number,
          wCore: number,
          alpha: number,
          c: Palette,
        ) => {
          ctx.beginPath();
          ctx.moveTo(pts[0][0], pts[0][1]);
          for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j][0], pts[j][1]);
          // soft glow pass
          ctx.globalAlpha = alpha * 0.5;
          ctx.lineWidth = wGlow;
          ctx.strokeStyle = c.glow2;
          ctx.shadowBlur = 9;
          ctx.shadowColor = c.glow;
          ctx.stroke();
          // thin crisp core pass
          ctx.globalAlpha = alpha;
          ctx.lineWidth = wCore;
          ctx.strokeStyle = c.core;
          ctx.shadowBlur = 4;
          ctx.shadowColor = c.glow;
          ctx.stroke();
        };

        const draw = () => {
          ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
          const c = palette();
          ctx.lineJoin = "round";
          ctx.lineCap = "round";
          for (let i = bolts.length - 1; i >= 0; i--) {
            const b = bolts[i];
            b.life -= 0.07;
            if (b.life <= 0) {
              bolts.splice(i, 1);
              continue;
            }
            strokePath(b.main, 2.2, 0.7, b.life, c);
            for (const br of b.branches) strokePath(br, 1.3, 0.45, b.life * 0.8, c);
          }
          ctx.globalAlpha = 1;
          ctx.shadowBlur = 0;
          raf = bolts.length ? requestAnimationFrame(draw) : 0;
        };

        window.addEventListener(
          "pointermove",
          (e) => {
            const x = e.clientX,
              y = e.clientY;
            if (!hasPrev) {
              prevX = x;
              prevY = y;
              hasPrev = true;
              return;
            }
            const dist = Math.hypot(x - prevX, y - prevY);
            // Treat a big jump (re-entry / teleport) as a fresh start, no bolt.
            if (dist > 300) {
              prevX = x;
              prevY = y;
              lastSpawn = e.timeStamp;
              return;
            }
            if (e.timeStamp - lastSpawn > 45 && dist > 8) {
              const displace = Math.min(dist * 0.45, 30);
              const main = makeBolt(prevX, prevY, x, y, displace);
              bolts.push({ main, branches: makeBranches(main), life: 1 });
              if (bolts.length > 12) bolts.shift();
              lastSpawn = e.timeStamp;
              prevX = x;
              prevY = y;
              if (!raf) raf = requestAnimationFrame(draw);
            }
          },
          { passive: true },
        );
      }
    </script>

    {/* Time-delayed entrance — adds .in to elements after data-show-delay ms */}
    <script>
      for (const el of document.querySelectorAll<HTMLElement>("[data-show-delay]")) {
        const delay = +(el.getAttribute("data-show-delay") ?? "0");
        setTimeout(() => el.classList.add("in"), delay);
      }
    </script>

    {/* Magnetic buttons — translate toward cursor on hover.
        Skipped when the user prefers reduced motion. */}
    <script>
      const reducedMotionMagnet = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reducedMotionMagnet) {
        const STRENGTH = 0.35;
        for (const el of document.querySelectorAll<HTMLElement>(
          "[data-magnet]",
        )) {
          el.addEventListener("mousemove", (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * STRENGTH;
            const y = (e.clientY - r.top - r.height / 2) * STRENGTH;
            el.style.transform = `translate(${x}px, ${y}px)`;
          });
          el.addEventListener("mouseleave", () => {
            el.style.transform = "";
          });
        }
      }
    </script>

    {/* Typewriter — types text with a blinking caret. Supports:
        data-typewrite (text), data-delay (ms before start),
        data-speed (ms/char, default 22), data-on-view (start when scrolled
        in), data-after (id of another typewriter element to chain after),
        data-tail (HTML appended after typing completes). */}
    <script>
      const reducedMotionTw = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      function typewrite(
        el: HTMLElement,
        text: string,
        speed: number,
        onDone?: () => void,
      ) {
        // Respect prefers-reduced-motion: render the full text instantly,
        // skip the caret + per-char animation entirely.
        if (reducedMotionTw) {
          el.textContent = text;
          onDone?.();
          return;
        }
        el.innerHTML =
          '<span class="tw-text"></span><span class="tw-caret">▍</span>';
        const textSpan = el.querySelector<HTMLSpanElement>(".tw-text")!;
        const caret = el.querySelector<HTMLSpanElement>(".tw-caret")!;
        let i = 0;
        const tick = () => {
          i++;
          textSpan.textContent = text.slice(0, i);
          if (i < text.length) setTimeout(tick, speed);
          else {
            caret.remove();
            onDone?.();
          }
        };
        tick();
      }

      for (const el of document.querySelectorAll<HTMLElement>(
        "[data-typewrite]",
      )) {
        const text = el.getAttribute("data-typewrite") ?? "";
        const delay = +(el.getAttribute("data-delay") ?? "0");
        const speed = +(el.getAttribute("data-speed") ?? "22");
        const onView = el.hasAttribute("data-on-view");
        const tail = el.getAttribute("data-tail");
        const afterId = el.getAttribute("data-after");

        const start = () =>
          setTimeout(() => {
            typewrite(el, text, speed, () => {
              if (tail) el.insertAdjacentHTML("beforeend", tail);
              el.dispatchEvent(new CustomEvent("typewrite-done"));
            });
          }, delay);

        if (afterId) {
          const after = document.getElementById(afterId);
          if (after) {
            after.addEventListener("typewrite-done", start, { once: true });
          } else {
            start();
          }
        } else if (onView) {
          if ("IntersectionObserver" in window) {
            const obs = new IntersectionObserver(
              (entries) => {
                for (const e of entries) {
                  if (e.isIntersecting) {
                    start();
                    obs.disconnect();
                    return;
                  }
                }
              },
              { threshold: 0.1 },
            );
            obs.observe(el);
          } else {
            start();
          }
        } else {
          start();
        }
      }
    </script>
  </body>
</html>
