---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const me = {
  fullName: "Patchamet Sriaksorn",
  nickname: "Ohm",
  title: "Fullstack Developer",
  blurb:
    "Currently at MLB Solution, building backend services for a content management platform on AWS serverless.",
  email: "Patchamet.s@gmail.com",
  social: {
    github: "https://github.com/patchamet",
  },
};

// --- Timeline data: jobs + projects + education merged, sorted desc by endYear ---

type Section = {
  label: string;
  items: string[];
  /** "list" = bulleted list, "chips" = chip row, "inline" = comma-joined inline */
  variant?: "list" | "chips" | "inline";
};

type TimelineJob = {
  kind: "job";
  endYear: number;
  role: string;
  company: string;
  period: string;
  sections?: Section[];
  summary?: string;
  stack: string[];
};

type TimelineProject = {
  kind: "project";
  endYear: number;
  id: string;
  title: string;
  role: string;
  period: string;
  summary: string;
  stack: string[];
  links?: { repo?: string; live?: string; caseStudy?: string };
  Content: any;
};

type TimelineEducation = {
  kind: "education";
  endYear: number;
  degree: string;
  school: string;
  period: string;
  summary?: string;
};

type TimelineEntry = TimelineJob | TimelineProject | TimelineEducation;

const jobs: TimelineJob[] = [
  {
    kind: "job",
    endYear: 9999,
    role: "Fullstack Developer",
    company: "MLB Solution Co., Ltd.",
    period: "Dec 2019 – Present",
    sections: [
      {
        label: "Projects",
        items: [
          "Global CMS (in-house CMS)",
          "Cross-branch print relay for kiosk self-checkout",
          "Admin panel — UI + backend",
        ],
      },
      {
        label: "Built",
        items: [
          "AI agent workflow for the CMS codebase",
          "Misc internal tools — Windows services, admin scripts, etc.",
        ],
      },
      { label: "Responsible for", items: ["API", "Back-end website"] },
    ],
    stack: [
      "TypeScript",
      "Node.js",
      "C# .NET",
      "React",
      "Electron",
      "AWS Lambda",
      "DocumentDB",
      "MemoryDB",
      "Aurora MySQL",
      "S3",
      "SQS",
      "REST",
      "WebSocket",
      "LLM",
      "VectorDB",
      "Serverless Framework",
      "Docker",
    ],
  },
  {
    kind: "job",
    endYear: 2019,
    role: "Fullstack Developer",
    company: "You Drink I Drive",
    period: "Sep 2018 – Nov 2019",
    sections: [
      { label: "Maintained", items: ["Matching system between drivers and customers"] },
      { label: "Responsible for", items: ["API", "Back-end website"] },
    ],
    stack: ["Node.js", "MeteorJS", "NestJS", "Go", "MongoDB", "RethinkDB", "Docker", "AWS", "Apache Kafka", "REST", "WebSocket"],
  },
  {
    kind: "job",
    endYear: 2018,
    role: "Node.js & .NET Developer",
    company: "AddTech Hub",
    period: "Nov 2016 – Nov 2018",
    sections: [
      {
        label: "Projects",
        items: [
          "Virtual Branch Prototype",
          "API Core Bank Adapter for Virtual Branch",
          "Accounting & Auditing System",
        ],
      },
      { label: "Maintained", items: ["Mobile payment app"] },
      { label: "Responsible for", items: ["API", "Hardware connectors"] },
      {
        label: "Hardware",
        variant: "chips",
        items: [
          "EDC",
          "Fingerprint reader",
          "Smart card reader",
          "Magnetic card reader",
          "Barcode reader",
          "Machine camera",
        ],
      },
    ],
    stack: ["Node.js", "C# .NET", "C++", "Ruby on Rails", "MongoDB", "Oracle", "REST", "WebSocket", "TCP/IP", "PC/SC", "Serialport"],
  },
  {
    kind: "job",
    endYear: 2016,
    role: ".NET Developer",
    company: "Mastertech International",
    period: "Jan 2012 – Sep 2016",
    sections: [
      {
        label: "Projects",
        items: [
          "Car Maintenance",
          "GPS-Tracking Server — custom TCP listener for GPS trackers",
          "Helpdesk System",
        ],
      },
      { label: "Responsible for", items: ["Website", "API", "Hardware connectors"] },
    ],
    stack: ["VB.NET", "ASP.NET", "MySQL", "MongoDB", "REST", "SOAP", "TCP/IP", "Crystal Report", "Google Maps API"],
  },
  {
    kind: "job",
    endYear: 2011,
    role: ".NET Developer",
    company: "Business Competitive Intelligence",
    period: "Aug 2010 – Dec 2011",
    sections: [
      { label: "Project", items: ["Manufacturing Resource Planning (MRP) system"] },
    ],
    stack: ["VB.NET", "MSSQL", "Crystal Report"],
  },
  {
    kind: "job",
    endYear: 2010,
    role: "Audit Assistant",
    company: "Dharmniti Account & Tax",
    period: "Apr – Jul 2010",
    sections: [
      {
        label: "Engagements",
        items: [
          "Audited listed (publicly-traded) companies",
          "Closed fund books for a bank",
        ],
      },
    ],
    stack: [],
  },
];

const education: TimelineEducation[] = [
  {
    kind: "education",
    endYear: 2009,
    degree: "Bachelor of Business Administration",
    school: "Prince of Songkla University",
    period: "Graduated 2009",
    summary: "Major in Accounting Information System.",
  },
];

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projectEntries: TimelineProject[] = await Promise.all(
  allProjects.map(async (p) => ({
    kind: "project" as const,
    endYear: p.data.endYear,
    id: p.id,
    title: p.data.title,
    role: p.data.role,
    period: p.data.period,
    summary: p.data.summary,
    stack: p.data.stack,
    links: p.data.links,
    Content: (await render(p)).Content,
  }))
);

const timeline: TimelineEntry[] = [...jobs, ...projectEntries, ...education].sort(
  (a, b) => b.endYear - a.endYear
);

const yearLabel = (y: number) => (y >= 9999 ? "Now" : String(y));
---

<Layout title={`${me.fullName} (${me.nickname}) — ${me.title}`} description={me.blurb}>
  <SiteHeader />

  <main>
    <section class="hero container" id="top">
      <h1>
        <span class="zap-host">
          <svg class="zap zap-1" viewBox="0 0 10 30" aria-hidden="true">
            {/* Two stacked groups mirror the cursor trail's dual-pass stroke:
                a wide electric-blue body + a thin white-hot core on top, both
                sharing the same randomized points (kept in sync by JS). */}
            <g class="zap-body">
              <polyline points="5,0 1,6 7,8 3,16 8,19 4,30" />
              <polyline points="3,16 1,19" />
            </g>
            <g class="zap-core">
              <polyline points="5,0 1,6 7,8 3,16 8,19 4,30" />
              <polyline points="3,16 1,19" />
            </g>
          </svg>
          <span class="strike-wrap">
            <span class="omega-display flicker-on">
              <span class="pulse">Ω</span>
            </span>
          </span>
        </span>
        <span class="name-line" data-typewrite={me.fullName} data-delay="900"></span>
        <span class="callme" id="hero-callme" data-typewrite=" — Just Ohm is fine." data-after="hero-blurb" data-speed="60"></span>
      </h1>
      <p class="title" data-typewrite={`// ${me.title}`} data-delay="1520"></p>
      <p class="blurb" id="hero-blurb" data-typewrite={me.blurb} data-delay="2220" data-speed="12"></p>
      <div class="cta reveal-sm" data-show-delay="2820">
        <a class="btn primary" href="#timeline">
          <span class="btn-scanwrap" aria-hidden="true"><span class="btn-scan"></span></span>
          See my timeline
        </a>
        <a class="btn ghost" href={`mailto:${me.email}`}>
          <span class="btn-scanwrap" aria-hidden="true"><span class="btn-scan"></span></span>
          Get in touch
        </a>
      </div>
    </section>

    <section class="section container reveal" id="about">
      <h2><span class="marker"></span>About</h2>
      <p
        id="about-p1"
        class="about-prose"
        data-typewrite="I've been writing software since 2010, with a BBA in accounting before that. Spent the .NET years on banking and hardware integration, then Node.js on real-time and matching systems, now mostly TypeScript on AWS serverless and AI plumbing. I gravitate to systems where the data model has to be careful and the boundaries are unfamiliar."
        data-on-view
        data-speed="8"
      ></p>
    </section>

    <section class="section container" id="timeline">
      <h2><span class="marker"></span>Timeline</h2>
      <ol class="tl">
        {timeline.map((e) => {
          const anchor = e.kind === "project" ? `project-${e.id}` : undefined;
          return (
            <li class={`tl-entry tl-${e.kind} reveal`} id={anchor}>
              <span class="tl-year">{yearLabel(e.endYear)}</span>
              <span class="tl-dot" aria-hidden="true"></span>
              <div class="tl-card">
                {e.kind === "job" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.role}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.company}</p>
                    {e.summary && <p class="tl-summary">{e.summary}</p>}
                    {e.sections && e.sections.length > 0 && (
                      <dl class="tl-sections">
                        {e.sections.map((s) => {
                          // Default rule: short, tag-like items render inline; longer
                          // descriptive items render as a bulleted list.
                          const allShort = s.items.every((i) => i.length < 25);
                          const variant = s.variant ?? (allShort ? "inline" : "list");
                          return (
                            <>
                              <dt>{s.label}</dt>
                              <dd>
                                {variant === "inline" && <span>{s.items.join(", ")}</span>}
                                {variant === "list" && (
                                  <ul>
                                    {s.items.map((it) => <li>{it}</li>)}
                                  </ul>
                                )}
                                {variant === "chips" && (
                                  <ul class="chips">
                                    {s.items.map((it) => <li>{it}</li>)}
                                  </ul>
                                )}
                              </dd>
                            </>
                          );
                        })}
                      </dl>
                    )}
                    {e.stack.length > 0 && (
                      <ul class="stack">
                        {e.stack.map((t) => <li>{t}</li>)}
                      </ul>
                    )}
                  </>
                )}

                {e.kind === "project" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.title}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.role}</p>
                    <p class="tl-summary">{e.summary}</p>
                    {e.stack.length > 0 && (
                      <ul class="stack stack-accent">
                        {e.stack.map((t) => <li>{t}</li>)}
                      </ul>
                    )}
                    {e.links && (
                      <ul class="links">
                        {e.links.live && <li><a href={e.links.live}>Live →</a></li>}
                        {e.links.repo && <li><a href={e.links.repo}>Repo →</a></li>}
                        {e.links.caseStudy && <li><a href={e.links.caseStudy}>Case study →</a></li>}
                      </ul>
                    )}
                    <div class="prose">
                      <e.Content />
                    </div>
                  </>
                )}

                {e.kind === "education" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.degree}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.school}</p>
                    {e.summary && <p class="tl-summary">{e.summary}</p>}
                  </>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="section container reveal" id="contact">
      <h2><span class="marker"></span>Contact</h2>
      <p>
        Best reached by email at <a class="underline-link" href={`mailto:${me.email}`}>{me.email}</a>.
        Also on <a class="underline-link" href={me.social.github}>GitHub</a>.
      </p>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  main { padding-top: var(--space-8); }

  /* smooth anchor scrolling under sticky header */
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 4rem; }

  .hero { padding-block: var(--space-16) var(--space-12); }

  /* Eyebrow — terminal-style prompt */
  .eyebrow {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  /* h1 line — reserve height so typewriter doesn't shift layout */
  h1 .name-line {
    display: inline-block;
    min-height: 1em;
  }

  /* Ω wordmark — bigger, mono, with lightning zaps around it */
  .zap-host {
    position: relative;
    display: inline-block;
    margin-right: 0.3em;
    vertical-align: baseline;
  }
  /* On narrow viewports the name wraps below Ω. Force the wordmark
     onto its own line and add a small margin so it doesn't sit on
     top of the name. */
  @media (max-width: 32rem) {
    h1 .zap-host {
      display: block;
      margin-bottom: 0.15em;
      margin-right: 0;
    }
  }
  .omega-display {
    font-family: var(--font-mono);
    font-size: 1.3em;
    font-weight: 600;
    color: var(--ink);
    display: inline-block;
  }
  /* Zigzag SVG lightning bolts — positioned on LEFT / TOP / BOTTOM of Ω
     so they never reach into the name's reading area to the right.
     Plasma palette: white core + cyan inner glow + electric-blue halo. */
  .zap-host {
    --zap-core: #ffffff;
    --zap-glow-1: #00d4ff;
    --zap-glow-2: #0051ff;
  }
  :global([data-theme="light"]) .zap-host {
    /* Keep an icy sky-blue character but readable on the warm cream bg. The
       core is a softened sky-blue (#1f85bd, sat ~72%) — toned down from the
       vivid sky-600 #0284c7 but the same lightness, so it still clears the
       ~3:1 graphic threshold (~3.9:1) — wrapped in a paler sky glow so it
       reads as the light/electric baseline rather than a deep navy. A dark
       line on a light bg looks heavier than a bright line on dark
       (irradiation), so the light-mode stroke is kept thinner than dark's
       0.6. */
    --zap-core: #1f85bd;
    --zap-glow-1: #94cceb;
    --zap-glow-2: #52aee0;
    --zap-sw: 0.3;
    --zap-bw: 0.8;
  }
  .zap polyline {
    fill: none;
    /* round joins: with the finely-jagged path, miter joins spike out into
       dark-looking hooks at the sharp angles — round keeps it clean, like
       the cursor lightning (which uses ctx.lineJoin = "round"). */
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* Dual-pass stroke, matching the cursor trail: a wide electric-blue body
     at half opacity + a thin white-hot core. The cyan/blue glow is added by
     the strike keyframes' drop-shadows. */
  .zap .zap-body polyline {
    stroke: var(--zap-glow-2);
    stroke-width: var(--zap-bw, 0.95);
    opacity: 0.5;
  }
  .zap .zap-core polyline {
    stroke: var(--zap-core);
    stroke-width: var(--zap-sw, 0.32);
  }
  .zap {
    position: absolute;
    width: 0.55em;
    height: 1.6em;
    pointer-events: none;
    opacity: 0;
    overflow: visible;
  }
  /* Single bolt striking from top-left. JS adds `.striking` to fire
     the one-shot animation at random intervals (0.5-3.5s gaps). */
  .zap-1 {
    top: -1.3em;
    left: -0.6em;
    transform: rotate(-28deg);
  }
  .zap-1.striking {
    animation: zap-flash-once 350ms ease-out forwards;
  }
  @keyframes zap-flash-once {
    0%   { opacity: 0; filter: none; }
    20%  {
      opacity: 1;
      filter:
        drop-shadow(0 0 2px var(--zap-glow-1))
        drop-shadow(0 0 6px var(--zap-glow-2));
    }
    40%  {
      opacity: 0.4;
      filter: drop-shadow(0 0 1px var(--zap-glow-1));
    }
    60%  {
      opacity: 1;
      filter:
        drop-shadow(0 0 3px var(--zap-glow-1))
        drop-shadow(0 0 8px var(--zap-glow-2));
    }
    100% { opacity: 0; filter: none; }
  }

  /* Strike effect on Ω — fired alongside the bolt via JS. */
  .strike-wrap {
    display: inline-block;
  }
  .strike-wrap.striking {
    animation: strike-once 350ms ease-out forwards;
  }
  @keyframes strike-once {
    0%   { filter: none; }
    20%  {
      filter:
        brightness(1.4)
        drop-shadow(0 0 4px var(--zap-glow-1))
        drop-shadow(0 0 12px var(--zap-glow-2));
    }
    40%  {
      filter:
        brightness(1.1)
        drop-shadow(0 0 2px var(--zap-glow-1));
    }
    60%  {
      filter:
        brightness(1.4)
        drop-shadow(0 0 6px var(--zap-glow-1))
        drop-shadow(0 0 18px var(--zap-glow-2));
    }
    100% { filter: none; }
  }

  /* Inline aside next to the name in h1 — small mono, muted */
  h1 .callme {
    font-family: var(--font-mono);
    font-size: 0.4em;
    font-weight: 400;
    color: var(--ink-2);
    letter-spacing: 0;
    margin-left: 0.3em;
    display: inline-block;
    min-height: 1em;
    vertical-align: middle;
  }
  .title {
    font-family: var(--font-mono);
    color: var(--ink-2);
    margin-bottom: var(--space-6);
    min-height: 1em;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  .blurb {
    max-width: 38rem;
    font-size: 1.125rem;
    min-height: 5em; /* reserve room while typewriter fills in */
  }

  .wordmark {
    color: var(--ink);
    font-family: var(--font-mono);
    margin-left: 0.1em;
  }

  /* About prose — pre-reserve height to soften the layout shift when typing */
  .about-prose {
    min-height: 1em;
  }

  /* Typewriter caret + text wrapper inside [data-typewrite] */
  :global(.tw-text) { display: inline; }
  :global(.tw-caret) {
    display: inline-block;
    width: 1ch;
    margin-left: 0.05em;
    animation: blink 1s step-end infinite;
    color: currentColor;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .cta { display: flex; gap: var(--space-4); margin-top: var(--space-6); }
  .btn {
    position: relative;
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: 3px; /* angular component look (was a pill) */
    border: 1px solid var(--ink-2);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    transition: transform 0.3s var(--ease-smooth), box-shadow 0.3s var(--ease-smooth), background 0.3s, color 0.3s;
  }
  /* gentle "pick it up" lift — soft, non-bouncy, same on both buttons */
  .btn:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.13);
  }
  .btn.primary { background: var(--color-accent); color: var(--color-bg); border-color: var(--color-accent); }
  .btn.ghost { background: transparent; color: var(--color-text); }
  .btn.ghost:hover { background: var(--color-accent-soft); }

  /* "Scan energize" — the button stays monochrome; only these overlays use
     the lightning/circuit colour (--pcb-pulse, theme-aware: sky-600 light /
     cyan dark). A scan line sweeps across on hover; the four corner solder
     nodes pulse a slow glow while the button is hovered. */
  /* clips the sweeping band to the button so it never spills past the edge;
     the corner nodes live OUTSIDE this wrapper so their glow can still bloom */
  .btn-scanwrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .btn-scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 54px; /* a band: bright leading edge + faint trailing wake */
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--pcb-pulse) 16%, transparent) 60%,
      color-mix(in srgb, var(--pcb-pulse) 55%, transparent) 90%,
      var(--pcb-pulse) 100%
    );
    opacity: 0;
    pointer-events: none;
  }
  .btn:hover .btn-scan { animation: btn-scan 1.2s var(--ease-smooth); }
  @keyframes btn-scan {
    0%   { left: -54px; opacity: 0; }
    12%  { opacity: 0.9; }
    88%  { opacity: 0.9; }
    100% { left: 100%; opacity: 0; }
  }
  /* slow-blinking electric edge while hovered (an overlay border so it can
     glow without affecting the button's own monochrome border) */
  .btn::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--pcb-pulse);
    box-shadow: 0 0 6px var(--pcb-pulse);
    opacity: 0;
    pointer-events: none;
  }
  .btn:hover::after { animation: btn-edge-blink 2.4s ease-in-out infinite; }
  @keyframes btn-edge-blink {
    0%, 100% { opacity: 0.22; box-shadow: 0 0 3px var(--pcb-pulse); }
    50%      { opacity: 1;    box-shadow: 0 0 9px var(--pcb-pulse); }
  }

  .section { padding-block: var(--space-12); border-top: 1px solid var(--color-border); }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* Vertical spine, between year column and dot */
  .tl::before {
    content: "";
    position: absolute;
    left: calc(4rem + 1rem + 6px); /* year col + gap + half-dot */
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: var(--color-border);
  }

  .tl-entry {
    position: relative;
    padding-left: calc(4rem + 1rem + 14px + var(--space-6)); /* year + gap + dot + gap to card */
    padding-bottom: var(--space-8);
    scroll-margin-top: 5rem;
  }
  .tl-entry:last-child { padding-bottom: 0; }

  .tl-year {
    position: absolute;
    left: 0;
    top: 18px;
    width: 4rem;
    text-align: right;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
  }

  .tl-dot {
    position: absolute;
    left: calc(4rem + 1rem); /* end of year col + gap */
    top: 18px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    z-index: 1;
  }
  .tl-project .tl-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .tl-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
