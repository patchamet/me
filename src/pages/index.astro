---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const me = {
  fullName: "Patchamet Sriaksorn",
  nickname: "Ohm",
  title: "Fullstack Developer",
  blurb:
    "Currently at MLB Solution, building backend services for a content management platform on AWS serverless.",
  email: "Patchamet.s@gmail.com",
  social: {
    github: "https://github.com/patchamet",
  },
};

// --- Timeline data: jobs + projects + education merged, sorted desc by endYear ---

type Section = {
  label: string;
  items: string[];
  /** "list" = bulleted list, "chips" = chip row, "inline" = comma-joined inline */
  variant?: "list" | "chips" | "inline";
};

type TimelineJob = {
  kind: "job";
  endYear: number;
  role: string;
  company: string;
  period: string;
  sections?: Section[];
  summary?: string;
  stack: string[];
};

type TimelineProject = {
  kind: "project";
  endYear: number;
  id: string;
  title: string;
  role: string;
  period: string;
  summary: string;
  stack: string[];
  links?: { repo?: string; live?: string; caseStudy?: string };
  Content: any;
};

type TimelineEducation = {
  kind: "education";
  endYear: number;
  degree: string;
  school: string;
  period: string;
  summary?: string;
};

type TimelineEntry = TimelineJob | TimelineProject | TimelineEducation;

const jobs: TimelineJob[] = [
  {
    kind: "job",
    endYear: 9999,
    role: "Fullstack Developer",
    company: "MLB Solution Co., Ltd.",
    period: "Dec 2019 – Present",
    sections: [
      {
        label: "Projects",
        items: [
          "Global CMS (in-house CMS)",
          "Cross-branch print relay for kiosk self-checkout",
          "Admin panel — UI + backend",
        ],
      },
      {
        label: "Built",
        items: [
          "AI agent workflow for the CMS codebase",
          "Misc internal tools — Windows services, admin scripts, etc.",
        ],
      },
      { label: "Responsible for", items: ["API", "Back-end website"] },
    ],
    stack: [
      "TypeScript",
      "Node.js",
      "C# .NET",
      "React",
      "Electron",
      "AWS Lambda",
      "DocumentDB",
      "MemoryDB",
      "Aurora MySQL",
      "S3",
      "SQS",
      "REST",
      "WebSocket",
      "LLM",
      "VectorDB",
      "Serverless Framework",
      "Docker",
    ],
  },
  {
    kind: "job",
    endYear: 2019,
    role: "Fullstack Developer",
    company: "You Drink I Drive",
    period: "Sep 2018 – Nov 2019",
    sections: [
      { label: "Maintained", items: ["Matching system between drivers and customers"] },
      { label: "Responsible for", items: ["API", "Back-end website"] },
    ],
    stack: ["Node.js", "MeteorJS", "NestJS", "Go", "MongoDB", "RethinkDB", "Docker", "AWS", "Apache Kafka", "REST", "WebSocket"],
  },
  {
    kind: "job",
    endYear: 2018,
    role: "Node.js & .NET Developer",
    company: "AddTech Hub",
    period: "Nov 2016 – Nov 2018",
    sections: [
      {
        label: "Projects",
        items: [
          "Virtual Branch Prototype",
          "API Core Bank Adapter for Virtual Branch",
          "Accounting & Auditing System",
        ],
      },
      { label: "Maintained", items: ["Mobile payment app"] },
      { label: "Responsible for", items: ["API", "Hardware connectors"] },
      {
        label: "Hardware",
        variant: "chips",
        items: [
          "EDC",
          "Fingerprint reader",
          "Smart card reader",
          "Magnetic card reader",
          "Barcode reader",
          "Machine camera",
        ],
      },
    ],
    stack: ["Node.js", "C# .NET", "C++", "Ruby on Rails", "MongoDB", "Oracle", "REST", "WebSocket", "TCP/IP", "PC/SC", "Serialport"],
  },
  {
    kind: "job",
    endYear: 2016,
    role: ".NET Developer",
    company: "Mastertech International",
    period: "Jan 2012 – Sep 2016",
    sections: [
      {
        label: "Projects",
        items: [
          "Car Maintenance",
          "GPS-Tracking Server — custom TCP listener for GPS trackers",
          "Helpdesk System",
        ],
      },
      { label: "Responsible for", items: ["Website", "API", "Hardware connectors"] },
    ],
    stack: ["VB.NET", "ASP.NET", "MySQL", "MongoDB", "REST", "SOAP", "TCP/IP", "Crystal Report", "Google Maps API"],
  },
  {
    kind: "job",
    endYear: 2011,
    role: ".NET Developer",
    company: "Business Competitive Intelligence",
    period: "Aug 2010 – Dec 2011",
    sections: [
      { label: "Project", items: ["Manufacturing Resource Planning (MRP) system"] },
    ],
    stack: ["VB.NET", "MSSQL", "Crystal Report"],
  },
  {
    kind: "job",
    endYear: 2010,
    role: "Audit Assistant",
    company: "Dharmniti Account & Tax",
    period: "Apr – Jul 2010",
    sections: [
      {
        label: "Engagements",
        items: [
          "Audited listed (publicly-traded) companies",
          "Closed fund books for a bank",
        ],
      },
    ],
    stack: [],
  },
];

const education: TimelineEducation[] = [
  {
    kind: "education",
    endYear: 2009,
    degree: "Bachelor of Business Administration",
    school: "Prince of Songkla University",
    period: "Graduated 2009",
    summary: "Major in Accounting Information System.",
  },
];

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const projectEntries: TimelineProject[] = await Promise.all(
  allProjects.map(async (p) => ({
    kind: "project" as const,
    endYear: p.data.endYear,
    id: p.id,
    title: p.data.title,
    role: p.data.role,
    period: p.data.period,
    summary: p.data.summary,
    stack: p.data.stack,
    links: p.data.links,
    Content: (await render(p)).Content,
  }))
);

const timeline: TimelineEntry[] = [...jobs, ...projectEntries, ...education].sort(
  (a, b) => b.endYear - a.endYear
);

const yearLabel = (y: number) => (y >= 9999 ? "Now" : String(y));

// "Currently using" derived from the most recent (ongoing) job
const currentJob = jobs.find((j) => j.endYear >= 9999);
const currentStack = currentJob?.stack ?? [];
---

<Layout title={`${me.fullName} (${me.nickname}) — ${me.title}`} description={me.blurb}>
  <SiteHeader />

  <main>
    <section class="hero container" id="top">
      <p class="eyebrow">whoami</p>
      <h1>
        <span class="zap-host">
          <svg class="zap zap-1" viewBox="0 0 10 30" aria-hidden="true">
            <polyline points="5,0 2,8 6,10 3,18 7,20 4,30" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="round"></polyline>
          </svg>
          <svg class="zap zap-2" viewBox="0 0 10 30" aria-hidden="true">
            <polyline points="5,0 8,8 4,10 7,18 3,20 6,30" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="round"></polyline>
          </svg>
          <svg class="zap zap-3" viewBox="0 0 10 30" aria-hidden="true">
            <polyline points="4,0 2,12 6,14 3,28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="round"></polyline>
          </svg>
          <svg class="zap zap-4" viewBox="0 0 10 30" aria-hidden="true">
            <polyline points="6,0 8,12 4,14 7,28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="round"></polyline>
          </svg>
          <span class="omega-display flicker-on">
            <span class="pulse">Ω</span>
          </span>
        </span>
        <span class="name-line" data-typewrite={me.fullName} data-delay="900"></span>
      </h1>
      <p class="title" data-typewrite={`// ${me.title}`} data-delay="1520"></p>
      <p class="blurb" data-typewrite={me.blurb} data-delay="2220" data-speed="12"></p>
      <div class="cta reveal-sm" data-show-delay="2820">
        <a class="btn primary" href="#timeline" data-magnet>See my timeline</a>
        <a class="btn ghost" href={`mailto:${me.email}`}>Get in touch</a>
      </div>
    </section>

    <section class="section container reveal" id="about">
      <h2><span class="marker"></span>About</h2>
      <p
        id="about-p1"
        class="about-prose"
        data-typewrite="I've been writing software since 2010, with a BBA in accounting before that. Spent the .NET years on banking and hardware integration, then Node.js on real-time and matching systems, now mostly TypeScript on AWS serverless and AI plumbing. I gravitate to systems where the data model has to be careful and the boundaries are unfamiliar."
        data-on-view
        data-speed="8"
      ></p>
      <p
        class="about-prose"
        data-typewrite="This site is a slow project to keep my own work in one place."
        data-after="about-p1"
        data-speed="8"
      ></p>
    </section>

    <section class="section container" id="timeline">
      <h2><span class="marker"></span>Timeline</h2>
      {currentStack.length > 0 && (
        <div class="now reveal">
          <span class="now-label">Currently using</span>
          <ul class="now-stack">
            {currentStack.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      )}
      <ol class="tl">
        {timeline.map((e) => {
          const anchor = e.kind === "project" ? `project-${e.id}` : undefined;
          return (
            <li class={`tl-entry tl-${e.kind} reveal`} id={anchor}>
              <span class="tl-year">{yearLabel(e.endYear)}</span>
              <span class="tl-dot" aria-hidden="true"></span>
              <div class="tl-card">
                {e.kind === "job" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.role}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.company}</p>
                    {e.summary && <p class="tl-summary">{e.summary}</p>}
                    {e.sections && e.sections.length > 0 && (
                      <dl class="tl-sections">
                        {e.sections.map((s) => {
                          // Default rule: short, tag-like items render inline; longer
                          // descriptive items render as a bulleted list.
                          const allShort = s.items.every((i) => i.length < 25);
                          const variant = s.variant ?? (allShort ? "inline" : "list");
                          return (
                            <>
                              <dt>{s.label}</dt>
                              <dd>
                                {variant === "inline" && <span>{s.items.join(", ")}</span>}
                                {variant === "list" && (
                                  <ul>
                                    {s.items.map((it) => <li>{it}</li>)}
                                  </ul>
                                )}
                                {variant === "chips" && (
                                  <ul class="chips">
                                    {s.items.map((it) => <li>{it}</li>)}
                                  </ul>
                                )}
                              </dd>
                            </>
                          );
                        })}
                      </dl>
                    )}
                    {e.stack.length > 0 && (
                      <ul class="stack">
                        {e.stack.map((t) => <li>{t}</li>)}
                      </ul>
                    )}
                  </>
                )}

                {e.kind === "project" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.title}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.role}</p>
                    <p class="tl-summary">{e.summary}</p>
                    {e.stack.length > 0 && (
                      <ul class="stack stack-accent">
                        {e.stack.map((t) => <li>{t}</li>)}
                      </ul>
                    )}
                    {e.links && (
                      <ul class="links">
                        {e.links.live && <li><a href={e.links.live}>Live →</a></li>}
                        {e.links.repo && <li><a href={e.links.repo}>Repo →</a></li>}
                        {e.links.caseStudy && <li><a href={e.links.caseStudy}>Case study →</a></li>}
                      </ul>
                    )}
                    <div class="prose">
                      <e.Content />
                    </div>
                  </>
                )}

                {e.kind === "education" && (
                  <>
                    <div class="tl-head">
                      <h3>{e.degree}</h3>
                      <span class="tl-period">{e.period}</span>
                    </div>
                    <p class="tl-sub">{e.school}</p>
                    {e.summary && <p class="tl-summary">{e.summary}</p>}
                  </>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="section container reveal" id="contact">
      <h2><span class="marker"></span>Contact</h2>
      <p>
        Best reached by email at <a class="underline-link" href={`mailto:${me.email}`}>{me.email}</a>.
        Also on <a class="underline-link" href={me.social.github}>GitHub</a>.
      </p>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  main { padding-top: var(--space-8); }

  /* smooth anchor scrolling under sticky header */
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 4rem; }

  .hero { padding-block: var(--space-16) var(--space-12); }

  /* Eyebrow — terminal-style prompt */
  .eyebrow {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  /* h1 line — reserve height so typewriter doesn't shift layout */
  h1 .name-line {
    display: inline-block;
    min-height: 1em;
  }

  /* Ω wordmark — bigger, mono, with lightning zaps around it */
  .zap-host {
    position: relative;
    display: inline-block;
    margin-right: 0.3em;
    vertical-align: baseline;
  }
  .omega-display {
    font-family: var(--font-mono);
    font-size: 1.3em;
    font-weight: 600;
    color: var(--ink);
    display: inline-block;
  }
  /* Zigzag SVG lightning bolts radiating around Ω */
  .zap {
    position: absolute;
    width: 0.4em;
    height: 1.1em;
    pointer-events: none;
    opacity: 0;
    overflow: visible;
  }
  .zap-1 {
    top: -1em;
    right: -0.3em;
    transform: rotate(25deg);
    animation: zap-flash 5s ease-out infinite 0.4s;
  }
  .zap-2 {
    top: -0.8em;
    left: -0.3em;
    transform: rotate(-30deg);
    animation: zap-flash 5s ease-out infinite 2s;
  }
  .zap-3 {
    top: 0.2em;
    right: -0.9em;
    transform: rotate(80deg);
    animation: zap-flash 5s ease-out infinite 3.4s;
  }
  .zap-4 {
    bottom: -0.7em;
    left: -0.2em;
    transform: rotate(-160deg);
    animation: zap-flash 5s ease-out infinite 1.2s;
  }

  .title {
    font-family: var(--font-mono);
    color: var(--ink-3);
    margin-bottom: var(--space-6);
    min-height: 1em;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
  .blurb {
    max-width: 38rem;
    font-size: 1.125rem;
    min-height: 5em; /* reserve room while typewriter fills in */
  }

  .wordmark {
    color: var(--ink);
    font-family: var(--font-mono);
    margin-left: 0.1em;
  }

  /* About prose — pre-reserve height to soften the layout shift when typing */
  .about-prose {
    min-height: 1em;
  }

  /* Typewriter caret + text wrapper inside [data-typewrite] */
  :global(.tw-text) { display: inline; }
  :global(.tw-caret) {
    display: inline-block;
    width: 1ch;
    margin-left: 0.05em;
    animation: blink 1s step-end infinite;
    color: currentColor;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .cta { display: flex; gap: var(--space-4); margin-top: var(--space-6); }
  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    transition: transform 0.25s var(--ease-overshoot), background 0.3s, color 0.3s;
  }
  .btn:hover { text-decoration: none; transform: translateY(-1px); }
  .btn.primary { background: var(--color-accent); color: var(--color-bg); border-color: var(--color-accent); }
  .btn.ghost { background: transparent; color: var(--color-text); }
  .btn.ghost:hover { background: var(--color-accent-soft); }

  .section { padding-block: var(--space-12); border-top: 1px solid var(--color-border); }

  /* Timeline — "Currently using" callout */
  .now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-6);
    background: var(--color-accent-soft);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 0;
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .now-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .now-stack li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* Vertical spine, between year column and dot */
  .tl::before {
    content: "";
    position: absolute;
    left: calc(4rem + 1rem + 6px); /* year col + gap + half-dot */
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: var(--color-border);
  }

  .tl-entry {
    position: relative;
    padding-left: calc(4rem + 1rem + 14px + var(--space-6)); /* year + gap + dot + gap to card */
    padding-bottom: var(--space-8);
    scroll-margin-top: 5rem;
  }
  .tl-entry:last-child { padding-bottom: 0; }

  .tl-year {
    position: absolute;
    left: 0;
    top: 18px;
    width: 4rem;
    text-align: right;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
  }

  .tl-dot {
    position: absolute;
    left: calc(4rem + 1rem); /* end of year col + gap */
    top: 18px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    z-index: 1;
  }
  .tl-project .tl-dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }

  .tl-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: var(--space-6);
    transition:
      transform 0.35s var(--ease-overshoot),
      border-color 0.35s;
  }
  .tl-card:hover {
    transform: translateY(-2px) rotate(-0.4deg);
    border-color: var(--ink);
  }
  .tl-project .tl-card {
    border-color: color-mix(in srgb, var(--ink) 30%, var(--line-2));
  }

  .tl-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .tl-head h3 { margin: 0; font-size: 1.0625rem; }
  .tl-project .tl-head h3 { font-size: 1.25rem; }
  .tl-period {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .tl-sub { color: var(--color-text-muted); margin: var(--space-1) 0 var(--space-3); }
  .tl-summary { font-size: 1rem; max-width: 38rem; }
  .tl-project .tl-summary { font-size: 1.0625rem; }

  /* Sections (Projects / Maintained / Responsible / Hardware) inside a job card */
  .tl-sections {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-4) 0 0;
  }
  .tl-sections dt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-top: 2px; /* align baseline with first dd line */
    white-space: nowrap;
  }
  .tl-sections dd {
    margin: 0;
    font-size: 0.9375rem;
    min-width: 0;
  }
  .tl-sections dd ul {
    list-style: disc;
    margin: 0;
    padding-left: 1.1rem;
  }
  .tl-sections dd ul li { margin-bottom: var(--space-1); }
  .tl-sections dd ul li:last-child { margin-bottom: 0; }
  .tl-sections dd ul.chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tl-sections dd ul.chips li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: 0;
  }

  /* Education entry: lower-key visual */
  .tl-education .tl-dot {
    background: var(--color-bg);
    border-color: var(--color-text-muted);
  }
  .tl-education .tl-card {
    background: transparent;
    border-style: dashed;
  }
  .tl-education .tl-head h3 {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  /* Stack chips */
  .stack {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--bg);
    border: 1px solid var(--line-2);
    padding: 2px var(--space-2);
    border-radius: 999px;
    transition:
      transform 0.25s var(--ease-overshoot),
      background 0.25s,
      color 0.25s;
  }
  .stack li:hover {
    transform: translateY(-2px) rotate(-2deg);
    background: var(--ink);
    color: var(--bg);
  }
  .stack-accent li {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-color: transparent;
  }

  .links {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
