---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const base = import.meta.env.BASE_URL;

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projects" description="Selected work and case studies.">
  <SiteHeader />

  <main class="container">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="muted">Selected work, with the problem, approach, and outcome of each.</p>
    </header>

    {projects.length === 0 ? (
      <p class="muted">No published projects yet.</p>
    ) : (
      <ul class="list">
        {projects.map((p) => (
          <li>
            <a href={`${base}projects/${p.id}`}>
              <div class="row">
                <h2>{p.data.title}</h2>
                <span class="period">{p.data.period}</span>
              </div>
              <p class="role">{p.data.role}</p>
              <p>{p.data.summary}</p>
              <ul class="stack">
                {p.data.stack.map((t) => <li>{t}</li>)}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>

  <SiteFooter />
</Layout>

<style>
  main { padding-block: var(--space-12); }
  .page-head { margin-bottom: var(--space-12); }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .list a {
    display: block;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .list a:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .row h2 { margin: 0; font-size: 1.25rem; }
  .period { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.875rem; }
  .role { color: var(--color-text-muted); margin: var(--space-1) 0 var(--space-3); }
  .stack {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }
  .muted { color: var(--color-text-muted); }
</style>
