---
// Theme toggle styled as a flat, sharp, frameless panel (no bezel). It toggles
// `data-theme` on <html> and persists the choice in localStorage.
//   DARK  = a dark clear-acrylic panel, lit moon (☾).
//   LIGHT = a solid white panel, pressed slightly in, grey sun (☀).
// Pure HTML + inline script, no framework.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle theme"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="t-glow" aria-hidden="true"></span>
  <span class="t-ic t-sun" aria-hidden="true">☀</span>
  <span class="t-ic t-moon" aria-hidden="true">☾</span>
</button>

<script>
  const root = document.documentElement;
  const STORAGE_KEY = "theme";

  function currentTheme(): "light" | "dark" {
    const explicit = root.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function applyTheme(t: "light" | "dark") {
    root.setAttribute("data-theme", t);
    try { localStorage.setItem(STORAGE_KEY, t); } catch (_) {}
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      btn.setAttribute("aria-pressed", String(t === "light")); // light = pressed/lit
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    btn.setAttribute("aria-pressed", String(currentTheme() === "light"));
    btn.addEventListener("click", () => {
      applyTheme(currentTheme() === "dark" ? "light" : "dark");
    });
  }
</script>

<style>
  /* flat, sharp, frameless panel (≈45x29) */
  .theme-toggle {
    position: relative;
    width: 45px;
    height: 29px;
    border: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s var(--ease-overshoot), box-shadow 0.32s, background 0.32s;
    /* DARK = dark clear-acrylic panel */
    transform: scale(1);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0) 20%),
      linear-gradient(180deg, rgba(20, 20, 21, 0.7), rgba(2, 2, 2, 0.92));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 0 0 9px rgba(0, 0, 0, 0.3),
      0 2px 6px rgba(0, 0, 0, 0.4);
  }
  /* thin flat top-edge catch (glassy read in dark) */
  .theme-toggle::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0, rgba(255, 255, 255, 0) 7%);
  }
  .t-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(78% 78% at 50% 50%, rgba(110, 110, 112, 0.06), rgba(0, 0, 0, 0) 74%);
  }

  /* LIGHT = solid white panel, pressed slightly in */
  :global([data-theme="light"]) .theme-toggle {
    transform: scale(0.94);
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.14),
      0 1px 3px rgba(0, 0, 0, 0.14);
  }
  :global([data-theme="light"]) .theme-toggle::before { background: none; }
  :global([data-theme="light"]) .t-glow { background: none; }
  .theme-toggle:active { transform: scale(0.9); }

  /* icons */
  .t-ic {
    position: absolute;
    z-index: 5;
    font-family: var(--font-mono);
    line-height: 1;
    transition: opacity 0.25s;
  }
  .t-sun { font-size: 14px; color: #84888c; opacity: 0; } /* grey sun, visible on white */
  .t-moon { font-size: 12px; color: #d2d5cf; opacity: 0.8; }
  :global([data-theme="light"]) .t-sun { opacity: 1; }
  :global([data-theme="light"]) .t-moon { opacity: 0; }
</style>
