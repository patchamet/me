---
// Theme toggle styled as a horizontal PCB "rail" slide switch. It toggles
// `data-theme` on <html> and persists the choice in localStorage.
//   DARK  = ON  : nub slid RIGHT, trace energized cyan (var(--pcb-pulse)),
//                 lit cyan ☾ riding on the nub.
//   LIGHT = OFF : nub slid LEFT, trace de-energized to neutral grey,
//                 gold ☀ riding on the nub.
// The ☀/☾ icon rides the moving nub so it is never occluded.
// Pure HTML + inline script, no framework.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle theme"
  aria-pressed="false"
  data-theme-toggle
>
  <span class="tt-rail" aria-hidden="true">
    <span class="tt-trace"></span>
    <span class="tt-pad tt-pad-l"></span>
    <span class="tt-pad tt-pad-r"></span>
  </span>
  <span class="tt-nub" aria-hidden="true">
    <span class="tt-ic tt-sun">☀</span>
    <span class="tt-ic tt-moon">☾</span>
  </span>
</button>

<script>
  const root = document.documentElement;
  const STORAGE_KEY = "theme";

  function currentTheme(): "light" | "dark" {
    const explicit = root.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function applyTheme(t: "light" | "dark") {
    root.setAttribute("data-theme", t);
    try { localStorage.setItem(STORAGE_KEY, t); } catch (_) {}
    for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      btn.setAttribute("aria-pressed", String(t === "light")); // light = pressed/lit
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    btn.setAttribute("aria-pressed", String(currentTheme() === "light"));
    btn.addEventListener("click", () => {
      applyTheme(currentTheme() === "dark" ? "light" : "dark");
    });
  }
</script>

<style>
  /* ===================================================================
     PCB rail slide switch — flat / sharp (border-radius:0 throughout).
     BASE (unqualified) selectors = DARK / ON look. Light/OFF is the
     :global([data-theme="light"]) override (data-theme lives on <html>).
     Accent = var(--pcb-pulse); intensity capped to var(--pcb-pulse-op),
     so it never glows louder than the ambient PCB-comet background.
     =================================================================== */
  .theme-toggle {
    --w: 52px;
    --h: 28px;
    --pad: 3px;
    --nub: calc(var(--h) - var(--pad) * 2);  /* 22px */
    --travel: calc(var(--w) - var(--h));     /* 24px */
    --op: var(--pcb-pulse-op, 0.47);

    position: relative;
    box-sizing: border-box;
    width: var(--w);
    height: var(--h);
    padding: 0;
    border: 0;
    border-radius: 0;             /* flat / sharp house aesthetic */
    cursor: pointer;
    display: inline-block;
    vertical-align: middle;
    font-family: var(--font-mono);
    -webkit-tap-highlight-color: transparent;
    /* dark recessed board substrate */
    background: linear-gradient(180deg, rgba(20, 20, 21, 0.7), rgba(2, 2, 2, 0.92));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      inset 0 1px 3px rgba(0, 0, 0, 0.55);
    transition: background 0.3s, box-shadow 0.3s;
  }

  /* recessed channel holding the trace + solder pads */
  .tt-rail {
    position: absolute;
    inset: var(--pad);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  /* PCB trace running pad-to-pad */
  .tt-trace {
    position: absolute;
    top: 50%;
    left: 7px;
    right: 7px;
    height: 2px;
    transform: translateY(-50%);
    background: var(--pcb-pulse, #00d4ff);
    opacity: var(--op);
    box-shadow: 0 0 5px var(--pcb-pulse, #00d4ff);
    animation: tt-pulse 2.4s ease-in-out infinite;
  }

  /* solder pads at each end */
  .tt-pad {
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    transform: translateY(-50%);
    background: #3a3d41;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  .tt-pad-l { left: 1px; }
  .tt-pad-r {
    right: 1px;
    background: var(--pcb-pulse, #00d4ff);
    box-shadow: 0 0 5px var(--pcb-pulse, #00d4ff);
    opacity: var(--op);
  }

  /* the sliding nub — sharp cap that CARRIES the icon (never occluded) */
  .tt-nub {
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    z-index: 3;
    width: var(--nub);
    height: var(--nub);
    border-radius: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #4a4d52, #25272b);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 1px 2px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 0, 0, 0.4);
    transform: translateX(var(--travel));  /* DARK / ON = thrown RIGHT */
    transition: transform 0.26s var(--ease-overshoot), background 0.3s, box-shadow 0.3s;
  }

  /* the two icons, stacked in the same grid cell + cross-faded */
  .tt-ic {
    grid-area: 1 / 1;
    line-height: 1;
    pointer-events: none;
    transition: opacity 0.22s;
  }
  .tt-sun {
    font-size: 13px;
    color: #ffb020;                                   /* vivid gold */
    text-shadow: 0 0 5px rgba(255, 176, 32, 0.75), 0 0 2px rgba(255, 210, 120, 0.9);
    opacity: 0;
  }
  .tt-moon {
    font-size: 12px;
    color: #4fe6ff;                                   /* vivid cyan */
    text-shadow: 0 0 6px var(--pcb-pulse, #00d4ff), 0 0 2px #cdf6ff;
    opacity: 1;
  }

  .theme-toggle:active .tt-nub { transform: translateX(var(--travel)) scaleX(0.9); }

  @keyframes tt-pulse {
    0%, 100% { opacity: calc(var(--op) * 0.6); }
    50%      { opacity: var(--op); }
  }

  /* ===================================================================
     LIGHT / OFF — nub slides LEFT, trace + pads de-energize to neutral
     cool grey (no copper), gold ☀ on the nub.
     =================================================================== */
  :global([data-theme="light"]) .theme-toggle {
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.16),
      inset 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  :global([data-theme="light"]) .tt-rail {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  :global([data-theme="light"]) .tt-trace {
    background: #aeb2b6;
    opacity: 0.55;
    box-shadow: none;
    animation: none;
  }
  :global([data-theme="light"]) .tt-pad {
    background: #c4c7cb;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
    opacity: 1;
  }
  :global([data-theme="light"]) .tt-pad-r {
    background: #c4c7cb;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  :global([data-theme="light"]) .tt-nub {
    transform: translateX(0);     /* thrown LEFT */
    background: linear-gradient(180deg, #ffffff, #dde0e4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 1px 2px rgba(0, 0, 0, 0.22),
      0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  :global([data-theme="light"]) .tt-sun {
    opacity: 1;
    color: #f5a000;                                   /* gold on white cap */
    text-shadow: 0 0 5px rgba(245, 160, 0, 0.6);
  }
  :global([data-theme="light"]) .tt-moon { opacity: 0; }
  :global([data-theme="light"]) .theme-toggle:active .tt-nub { transform: translateX(0) scaleX(0.9); }

  /* hover pre-glow on real pointers only */
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover .tt-nub {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.22),
        0 0 0 2px color-mix(in srgb, var(--pcb-pulse) 24%, transparent),
        0 1px 2px rgba(0, 0, 0, 0.55);
    }
    :global([data-theme="light"]) .theme-toggle:hover .tt-nub {
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        0 0 0 2px color-mix(in srgb, var(--pcb-pulse) 22%, transparent),
        0 1px 2px rgba(0, 0, 0, 0.22);
    }
  }

  /* keyboard focus */
  .theme-toggle:focus-visible {
    outline: 2px solid var(--pcb-pulse, #00d4ff);
    outline-offset: 2px;
  }

  /* reduced motion: state still carried by position + icon + brightness */
  @media (prefers-reduced-motion: reduce) {
    .tt-nub { transition: none; }
    .tt-trace { animation: none; }
    .theme-toggle:active .tt-nub { transform: translateX(var(--travel)); }
    :global([data-theme="light"]) .theme-toggle:active .tt-nub { transform: translateX(0); }
  }
</style>
